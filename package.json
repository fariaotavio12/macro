{
  "name": "macro",
  "private": true,
  "version": "0.2.1",
  "description": "Aplicativo desktop de macros para Windows: grava e reproduz mouse/teclado com atalhos globais, tecla de panico e loop.",
  "author": "Otavio Faria",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode localhost",
    "electron:dev": "vite --mode localhost",
    "electron:build": "tsc -b && vite build && electron-builder --publish never",
    "release": "tsc -b && vite build && electron-builder --publish always",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:main": "tsc -b && vite build --mode main",
    "setup:api-local": "node scripts/setup-api-local.mjs",
    "design:sync": "node scripts/sync-design-md.mjs",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "claude:install": "npm exec --yes --package otavio-claude-config -- claude-config install"
  },
  "dependencies": {
    "@blocknote/core": "^0.41.1",
    "@blocknote/mantine": "^0.41.1",
    "@blocknote/react": "^0.41.1",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@tanstack/react-table": "^8.21.3",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.4.2",
    "jimp": "0.22.10",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.24",
    "prosemirror-state": "^1.4.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.12.0",
    "recharts": "^2.15.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "save-as": "^0.1.8",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "uiohook-napi": "^1.5.5",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^16.5.0",
    "otavio-claude-config": "^1.0.3",
    "playwright": "^1.59.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "claudeConfig": {
    "profile": "react-vite"
  },
  "build": {
    "appId": "com.fariaotavio.macro",
    "productName": "Macro App",
    "artifactName": "Macro-App-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/@nut-tree-fork/**",
      "node_modules/@techstark/opencv-js/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
